diff --git a/docker-compose.yml b/docker-compose.yml
--- a/docker-compose.yml	(revision af2b643a294e7844aa01d355f6dae35f61b040bb)
+++ b/docker-compose.yml	(date 1743757654768)
@@ -1,0 +1,20 @@
+                        version: '3.8'
+
+services:
+  arxiv-api:
+    build: .
+    container_name: arxiv-api
+    ports:
+      - "8000:8000"
+    volumes:
+      # Mount the code for live reload
+      - ./api:/app/api
+      - ./scripts:/app/scripts
+      - ./src:/app/src
+      # Mount data directory to persist data
+      - ./data:/app/data
+    environment:
+      - API_HOST=0.0.0.0
+      - API_PORT=8000
+    restart: unless-stopped
+    command: uvicorn api.main:app --host 0.0.0.0 --port 8000 --reload
